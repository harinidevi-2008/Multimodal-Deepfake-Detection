# Copy to .env.development / .env.production as needed. Vite only exposes
# variables prefixed VITE_ to client code.

# Leave unset for local dev: the frontend calls relative /api/... paths and
# vite.config.js's dev proxy forwards them to the backend (see BACKEND_URL
# below). Set this to an absolute URL (e.g. https://api.example.com) for a
# production build where the frontend and backend are on different origins.
VITE_API_BASE_URL=

# Only used by `npm run dev` (not the built app) to configure the proxy
# target when the backend isn't on the default port.
BACKEND_URL=http://localhost:8000

# Set to "true" to run the frontend against the bundled mock JSON instead
# of a real backend — useful for UI-only work. Defaults to false (real
# backend) and should stay false for anything but local UI development.
VITE_USE_MOCK_API=false
